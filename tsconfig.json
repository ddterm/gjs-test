{
  "extends": [
    "@tsconfig/bases/strictest",
  ],
  "compilerOptions": {
    "target": "es2022",
    "module": "es2020",
    "lib": ["ES2022"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": false,
    "types": [
      "@girs/gjs",
      "@girs/gjs/dom",
      "@girs/glib-2.0",
      "@girs/gobject-2.0",
      "@girs/gio-2.0",
    ],
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": [
    "*.js",
    "tests/*.js",
  ],
}
