{
    "name": "gjs-test",
    "description": "A test runner and assertion library for GJS",
    "private": true,
    "homepage": "https://github.com/ddterm/gjs-test",
    "bugs": "https://github.com/ddterm/gjs-test/issues",
    "license": "MIT",
    "author": {
        "name": "Aleksandr Mezin",
        "email": "mezin.alexander@gmail.com",
        "url": "https://github.com/amezin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ddterm/gjs-test.git"
    },
    "type": "module",
    "devDependencies": {
        "@eslint/config-array": "0.23.5",
        "@eslint/js": "10.0.1",
        "@girs/gio-2.0": "5.5.0",
        "@girs/gjs": "5.5.0",
        "@tsconfig/bases": "1.0.28",
        "@types/node": "26.6.5",
        "eslint": "10.12.0",
        "eslint-config-gnome": "https://github.com/ddterm/eslint-config-gnome/archive/c479d059e8d9ea99c3b53c2ea43abf7fdb05eb51.tar.gz",
        "eslint-plugin-jsdoc": "65.4.0",
        "globals": "17.13.0",
        "npm-run-all2": "9.0.3",
        "typedoc": "0.28.20",
        "typedoc-plugin-mdn-links": "5.1.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0"
    },
    "overrides": {
        "eslint-config-gnome": {
            "@eslint/js": "$@eslint/js",
            "eslint-plugin-jsdoc": "$eslint-plugin-jsdoc"
        }
    },
    "scripts": {
        "lint:tsc:gjs": "tsc -p ./tsconfig.json",
        "lint:tsc:node": "tsc -p ./tsconfig.node.json",
        "lint:tsc": "run-s -c lint:tsc:*",
        "lint:eslint": "eslint",
        "lint": "run-s -c lint:*",
        "doc:typedoc": "typedoc",
        "doc": "run-s doc:*"
    }
}
